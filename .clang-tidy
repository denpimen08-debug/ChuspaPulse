# Configuración de Clang-Tidy para ChuspaPulse
# 
# Categorías activas:
# - bugprone-*: Detecta patrones de código propensos a errores lógicos y comportamientos inesperados.
# - performance-*: Identifica ineficiencias de rendimiento y optimizaciones de memoria/CPU.
# - cert-*: Evalúa reglas de codificación segura según los estándares CERT C/C++.

Checks: >
  -*,
  bugprone-*,
  performance-*,
  cert-*,
  -bugprone-easily-swappable-parameters,
  -cert-err33-c,
  -clang-diagnostic-*

# Convierte advertencias en errores excluyendo fallos de inclusión/compilación
WarningsAsErrors: 'bugprone-*,performance-*,cert-*,-clang-diagnostic-*'

# Filtra el análisis para enfocarlo en los archivos del proyecto dentro de src/
HeaderFilterRegex: 'src/.*'

FormatStyle: 'none'